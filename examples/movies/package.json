{
  "name": "example-movies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "blockdb example: a movie-catalog browser (NDJSON input, range + contains + multi-valued queries).",
  "scripts": {
    "generate-data": "node scripts/generate-data.mjs",
    "build-data": "node scripts/build-data.mjs",
    "dev": "pnpm run build-data && vite",
    "build": "pnpm run build-data && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "blockdb": "workspace:*"
  },
  "devDependencies": {
    "blockdb-cli": "workspace:*",
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "playwright": "latest"
  }
}
