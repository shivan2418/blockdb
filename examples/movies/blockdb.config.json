{
  "$schema": "./node_modules/blockdb-cli/config.schema.json",
  "collection": "movies",
  "input": {
    "path": "data/movies.ndjson"
  },
  "blockBytes": 65536,
  "schema": {
    "sortField": "year",
    "fields": {
      "id": { "kind": "string" },
      "title": { "kind": "string", "indexed": true, "contains": true },
      "year": { "kind": "number" },
      "rating": { "kind": "number", "indexed": true },
      "director": { "kind": "string", "indexed": true },
      "genres": { "kind": "string", "indexed": true, "multi": true },
      "overview": { "kind": "string" }
    }
  }
}
